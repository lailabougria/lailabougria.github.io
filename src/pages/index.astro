---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import KeynoteCard from '../components/KeynoteCard.astro';
import TalkCard from '../components/TalkCard.astro';
import UpcomingList from '../components/UpcomingList.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { getCollection } from 'astro:content';
import { getAllDeliveries, upcoming } from '../lib/schedule';
import stagePhoto from '../assets/photos/stage-wide.jpg';

const keynotes = await getCollection('keynotes', ({ data }) => !data.draft);
const talks = await getCollection('talks', ({ data }) => !data.draft);
const sortedTalks = [...talks].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const featuredTalks = sortedTalks.slice(0, 4);

const deliveries = await getAllDeliveries();
const upcomingItems = upcoming(deliveries);
---

<BaseLayout title="Laila Bougria">
	<main>
		<section class="hero-banner">
			<Image
				class="hero-bg"
				src={stagePhoto}
				alt="Laila Bougria presenting on stage to a packed conference hall"
				widths={[640, 1024, 1600, 2048]}
				sizes="100vw"
				loading="eager"
			/>
			<div class="hero-scrim"></div>
			<div class="hero-content wrap">
				<h1>Laila Bougria</h1>
				<p class="lede">
					Solutions Architect at Particular Software, 5x Microsoft MVP for Azure and
					Developer Technologies, two decades of hands-on experience designing, building
					and facilitating event-driven systems.
				</p>
				<div class="cta-row">
					<a class="btn primary" href="/contact/">Book a keynote</a>
					<a class="btn ghost" href="/talks/">Browse talks</a>
				</div>
			</div>
		</section>

		<div class="wrap">
			<section class="section upcoming-section" style="border-top: none;">
				<div class="section-head">
					<h2>Where I'll be</h2>
					<a class="tag" href="https://sessionize.com/noctovis" target="_blank" rel="noopener">
						full schedule on Sessionize ↗
					</a>
				</div>
				<UpcomingList items={upcomingItems} />
			</section>

			<section class="section">
				<div class="section-head">
					<h2>Featured keynotes</h2>
					<span class="tag">/keynotes</span>
				</div>
				<div class="card-grid">
					{keynotes.map((entry) => <KeynoteCard entry={entry} />)}
				</div>
			</section>

			<section class="section">
				<div class="section-head">
					<h2>Recent talks</h2>
					<span class="tag">/talks</span>
				</div>
				<div class="talk-list">
					{featuredTalks.map((entry) => <TalkCard entry={entry} />)}
				</div>
				<p style="margin-top: 24px;">
					<a class="btn ghost" href="/talks/">See all talks →</a>
				</p>
			</section>

			<section class="section" style="border-bottom: none;">
				<div class="section-head">
					<h2>Impressions of Laila in action</h2>
				</div>
				<PhotoCarousel />
			</section>
		</div>
	</main>
</BaseLayout>

<style>
	.hero-banner {
		position: relative;
		min-height: clamp(380px, 48vw, 560px);
		display: flex;
		align-items: flex-end;
		border-bottom: 1px solid var(--line);
	}
	.hero-banner :global(.hero-bg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		z-index: 0;
	}
	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(21, 19, 15, 0.8) 0%,
			rgba(21, 19, 15, 0.55) 55%,
			rgba(21, 19, 15, 0.15) 100%
		);
		z-index: 1;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		padding: 48px 28px 44px;
	}
	h1 {
		font-family: var(--script);
		font-weight: 400;
		font-size: clamp(56px, 10vw, 104px);
		letter-spacing: 0;
		margin: 0 0 8px;
		line-height: 1;
		color: var(--ink);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
	}
	.lede {
		display: block;
		font-size: 16px;
		color: var(--ink);
		max-width: 50ch;
		margin: 0 0 26px;
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
	}
	.cta-row {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.upcoming-section .section-head .tag {
		text-decoration: none;
	}
</style>