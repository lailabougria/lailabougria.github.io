---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/schedule';

export async function getStaticPaths() {
	const talks = await getCollection('talks', ({ data }) => !data.draft);
	return talks.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { title, categories, description, topics, deliveries, sessionizeUrl, photo, githubUrl } = entry.data;
const { Content } = await render(entry);

const sortedDeliveries = [...deliveries].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const recordings = sortedDeliveries.filter((d) => d.youtubeId);
---

<BaseLayout title={title} description={description}>
	<main class="wrap">
		<article class="page-hero">
			<p class="eyebrow">{categories.join(' · ')}</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			{
				topics.length > 0 && (
					<div class="topics">
						{topics.map((topic) => (
							<span class="tag">{topic}</span>
						))}
					</div>
				)
			}
			{
				sessionizeUrl && (
					<a class="sessionize-link" href={sessionizeUrl} target="_blank" rel="noopener">
						View on Sessionize →
					</a>
				)
			}
		</article>

		{
			photo && (
				<section class="section photo-section" style="border-top: none;">
					<Image class="talk-photo" src={photo} alt={title} width={960} />
				</section>
			)
		}

		{
			recordings.length > 0 && (
				<section class="section" style="border-top: none;">
					<div class="section-head">
						<h2>Watch</h2>
					</div>
					<div class="recordings">
						{recordings.map((r) => (
							<div>
								<YouTubeEmbed youtubeId={r.youtubeId!} title={`${title} — ${r.event}`} />
								<p class="recording-caption">
									{r.event}, {r.location} · {formatDate(r.date)}
								</p>
							</div>
						))}
					</div>
				</section>
			)
		}

		<div class="prose">
			<Content />
		</div>

		<section class="section cta-section" style="border-bottom: none;">
			<a class="btn primary" href="/contact/">Invite me to speak</a>
			{
				githubUrl && (
					<a class="btn ghost" href={githubUrl} target="_blank" rel="noopener">
						Resources &amp; code on GitHub ↗
					</a>
				)
			}
			<a class="btn ghost" href="/talks/">← All talks</a>
		</section>
	</main>
</BaseLayout>

<style>
	.page-hero {
		padding: 76px 0 40px;
	}
	h1 {
		font-family: var(--serif);
		font-weight: 500;
		font-size: clamp(30px, 4.4vw, 42px);
		margin: 0 0 18px;
	}
	.lede {
		display: block;
		font-size: 17px;
		color: var(--muted);
		max-width: 62ch;
		margin: 0 0 20px;
	}
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 18px;
	}
	.sessionize-link {
		display: inline-block;
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--accent-2);
		text-decoration: none;
		font-weight: 600;
	}

	.photo-section {
		padding-top: 0;
		padding-bottom: 24px;
	}
	.photo-section :global(.talk-photo) {
		width: 100%;
		max-width: 720px;
		height: auto;
		display: block;
		border-radius: 3px;
		border: 1px solid var(--line);
	}
	.photo-section + .section {
		padding-top: 24px;
		border-top: none;
	}

	.recordings {
		display: grid;
		gap: 28px;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
	}
	.recording-caption {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
		margin-top: 10px;
	}

	.prose {
		max-width: 68ch;
		font-size: 16.5px;
		color: var(--ink);
	}
	.prose :global(p) {
		margin: 0 0 18px;
	}

	.cta-section {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}
</style>