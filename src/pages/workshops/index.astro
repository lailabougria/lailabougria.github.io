---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkshopCard from '../../components/WorkshopCard.astro';
import { getCollection } from 'astro:content';

const workshops = await getCollection('workshops', ({ data }) => !data.draft);
---

<BaseLayout
	title="Workshops"
	description="Hands-on workshops on event-driven architecture by Laila Bougria, for conferences and in-house teams."
>
	<main class="wrap">
		<section class="page-hero">
			<h1>Workshops</h1>
			<p class="lede">
				Beyond keynotes and talks, I run hands-on workshops that draw on two decades of
				experience designing, building, and untangling event-driven systems. They run at
				conferences and directly in-house for companies who want to train their team
				together.
			</p>
		</section>

		<section class="section compare-section" style="border-top: none;">
			<div class="section-head">
				<h2>Conference vs. in-house</h2>
			</div>
			<div class="compare-grid">
				<div class="compare-card">
					<span class="badge">At a conference</span>
					<p>
						Runs alongside the conference schedule, typically as a 1 or 2-day format.
						Keeps to a tighter, fixed agenda, and puts you in the room with attendees
						from many different companies and domains — great for cross-pollinating
						ideas.
					</p>
				</div>
				<div class="compare-card">
					<span class="badge">In-house</span>
					<p>
						Delivered directly at your company so your whole team learns together.
						We can pull in domain-specific examples from your own systems, and the
						schedule leaves more room for open discussion on the problems you're
						actually facing.
					</p>
				</div>
			</div>
		</section>

		<section class="section workshops-section" style="border-bottom: none;">
			<div class="section-head">
				<h2>Learn about EDA</h2>
			</div>
			<div class="card-grid workshop-grid">
				{workshops.map((entry) => <WorkshopCard entry={entry} />)}
			</div>
			<p style="margin-top: 24px;">
				<a class="btn primary" href="/contact/">Enquire about a workshop</a>
			</p>
		</section>
	</main>
</BaseLayout>

<style>
	.page-hero {
		padding: 76px 0 20px;
	}
	h1 {
		font-family: var(--serif);
		font-weight: 500;
		font-size: clamp(34px, 5vw, 48px);
		margin: 0 0 20px;
	}
	.lede {
		display: block;
		font-size: 17px;
		color: var(--muted);
		max-width: 66ch;
	}

	.compare-section {
		padding-top: 8px;
		padding-bottom: 40px;
	}
	.workshops-section {
		padding-top: 32px;
	}

	.compare-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
	}
	.compare-card {
		background: var(--bg);
		padding: 26px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.compare-card .badge {
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.07em;
		color: var(--accent);
		text-transform: uppercase;
	}
	.compare-card p {
		font-size: 15px;
		color: var(--muted);
		margin: 0;
	}

	.card-grid.workshop-grid {
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
	}

	@media (max-width: 700px) {
		.compare-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
