---
import { Image } from 'astro:assets';

// Every photo dropped into src/assets/carrousel/ shows up here automatically —
// nothing to wire up, just add or remove files from that folder.
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/carrousel/*.{jpg,jpeg,png}', {
	eager: true,
});

const photos = Object.values(modules).map((mod) => mod.default);
---

{
	photos.length > 0 && (
		<div class="photo-carousel" data-carousel>
			{photos.map((photo, i) => (
				<div class="carousel-slide" data-active={i === 0 ? 'true' : 'false'}>
					<Image
						src={photo}
						alt="Laila Bougria speaking at conferences and community events"
						width={1200}
						loading={i === 0 ? 'eager' : 'lazy'}
					/>
				</div>
			))}
			{photos.length > 1 && (
				<>
					<button type="button" class="carousel-arrow prev" data-direction="-1" aria-label="Previous photo">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<button type="button" class="carousel-arrow next" data-direction="1" aria-label="Next photo">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
				</>
			)}
		</div>
	)
}

<script>
	const root = document.querySelector<HTMLElement>('[data-carousel]');
	if (root) {
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel-slide'));
		let current = Math.max(
			0,
			slides.findIndex((s) => s.dataset.active === 'true'),
		);

		const show = (index: number) => {
			slides[current].dataset.active = 'false';
			current = (index + slides.length) % slides.length;
			slides[current].dataset.active = 'true';
		};

		let timer: ReturnType<typeof setInterval> | undefined;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const startAutoplay = () => {
			if (slides.length > 1 && !reduceMotion) {
				timer = setInterval(() => show(current + 1), 4000);
			}
		};

		const restartAutoplay = () => {
			if (timer) clearInterval(timer);
			startAutoplay();
		};

		root.querySelectorAll<HTMLButtonElement>('.carousel-arrow').forEach((button) => {
			button.addEventListener('click', () => {
				show(current + Number(button.dataset.direction));
				restartAutoplay();
			});
		});

		startAutoplay();
	}
</script>

<style>
	.photo-carousel {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 3px;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.carousel-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 1.2s ease;
	}

	.carousel-slide[data-active='true'] {
		opacity: 1;
	}

	.carousel-slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.carousel-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid rgba(241, 236, 225, 0.35);
		background: rgba(21, 19, 15, 0.55);
		color: var(--ink);
		cursor: pointer;
		backdrop-filter: blur(2px);
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.carousel-arrow:hover {
		background: rgba(21, 19, 15, 0.8);
		border-color: var(--accent);
	}

	.carousel-arrow svg {
		width: 20px;
		height: 20px;
	}

	.carousel-arrow.prev {
		left: 16px;
	}

	.carousel-arrow.next {
		right: 16px;
	}
</style>
