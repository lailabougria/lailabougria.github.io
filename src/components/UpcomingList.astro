---
import { flagEmoji } from '../lib/flag';
import { formatDateShort, type ScheduleItem } from '../lib/schedule';

interface Props {
	items: ScheduleItem[];
}
const { items } = Astro.props;
---

{
	items.length > 0 ? (
		<div class="upcoming-list">
			{items.map((item) => {
				const detailHref = item.kind === 'keynote' ? `/keynotes/${item.slug}/` : `/talks/${item.slug}/`;
				return (
					<div class="upcoming-row">
						<span class="flag" aria-hidden="true">
							{item.countryCode ? flagEmoji(item.countryCode) : '📍'}
						</span>
						<span class="event">
							<span class="event-name">{item.event}</span>
							<span class="event-location">{item.location}</span>
						</span>
						<span class="date">{formatDateShort(item.date)}</span>
						<a class="session-title" href={detailHref}>
							{item.title}
						</a>
						{item.eventUrl && (
							<a class="cta" href={item.eventUrl} target="_blank" rel="noopener">
								Get tickets →
							</a>
						)}
					</div>
				);
			})}
		</div>
	) : (
		<div class="upcoming-row empty">
			<span class="event-name">No public dates on the calendar right now.</span>
			<span class="date">currently booking — get in touch</span>
		</div>
	)
}

<style>
	.upcoming-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--line);
	}

	.upcoming-row {
		display: grid;
		grid-template-columns: 36px 1.1fr auto 1.9fr auto;
		align-items: center;
		gap: 18px;
		padding: 18px 4px;
		border-bottom: 1px solid var(--line);
	}

	.flag {
		font-size: 24px;
		line-height: 1;
	}

	.event {
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}

	.event-name {
		font-size: 14.5px;
		font-weight: 600;
	}

	.event-location {
		font-family: var(--mono);
		font-size: 11.5px;
		color: var(--muted);
	}

	.date {
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--muted);
		white-space: nowrap;
	}

	.session-title {
		font-family: var(--serif);
		font-size: 18px;
		font-weight: 500;
		color: var(--ink);
		text-decoration: none;
		min-width: 0;
	}

	.session-title:hover {
		color: var(--accent);
	}

	.cta {
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--accent);
		white-space: nowrap;
		text-decoration: none;
	}

	.cta:hover {
		text-decoration: underline;
	}

	.upcoming-row.empty {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 14px;
	}
	.upcoming-row.empty .date {
		color: var(--accent-2);
	}

	@media (max-width: 860px) {
		.upcoming-row {
			grid-template-columns: 28px 1fr auto;
			row-gap: 8px;
		}
		.session-title,
		.cta {
			grid-column: 2 / -1;
		}
	}
</style>
