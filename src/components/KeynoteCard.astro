---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'keynotes'>;
}
const { entry } = Astro.props;
const { title, tagline, deliveries } = entry.data;

// Show where this keynote premiered, not the most recent booking.
const firstDelivery = [...deliveries].sort((a, b) => a.date.valueOf() - b.date.valueOf())[0];
---

<a class="card" href={`/keynotes/${entry.id}/`}>
	<span class="badge">Keynote</span>
	<h3>{title}</h3>
	<p>{tagline}</p>
	<div class="meta">
		{
			firstDelivery ? (
				<>
					<span>
						Conference: <b>{firstDelivery.event}, {firstDelivery.location}</b>
					</span>
					{firstDelivery.attendees && (
						<span>
							Attendees: <b>{firstDelivery.attendees}+</b>
						</span>
					)}
				</>
			) : (
				<span>Available to book</span>
			)
		}
	</div>
	<span class="link">Read more →</span>
</a>